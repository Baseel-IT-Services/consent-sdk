{
  "name": "@baseel/loader",
  "version": "0.0.1",
  "description": "Lightweight script-tag loader for the Baseel Consent SDK",
  "keywords": ["consent", "dpdp", "privacy", "sdk", "baseel", "loader"],
  "author": "Baseel",
  "license": "MIT",
  "homepage": "https://github.com/Baseel-IT-Services/consent-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Baseel-IT-Services/consent-sdk.git",
    "directory": "packages/loader"
  },
  "bugs": {
    "url": "https://github.com/baseel-sdk/baseel-sdk/issues"
  },
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
