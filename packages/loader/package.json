  },
  "dependencies": {
    "@baseel/types": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "terser": "^5.31.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
