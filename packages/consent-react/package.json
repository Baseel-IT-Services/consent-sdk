{
  "name": "@baseel/consent-react",
  "version": "0.1.0",
  "description": "React components for embedding Baseel consent screens (<BaseelConsent />)",
  "keywords": ["consent", "dpdp", "privacy", "sdk", "baseel", "react", "nextjs"],
  "author": "Baseel",
  "license": "MIT",
  "homepage": "https://github.com/baseel-sdk/baseel-sdk#readme",
  "repository": {
    "type": "git",
